/* ==========================================================================
   THE SHADOWS WITHIN: A B5 LEGACY - SPEZIFISCHE INHALTS-MODULE
   ========================================================================== */

/* ==========================================================================
   KONTAKTFORMULAR (Taktisches Crew-Interface)
   Strukturierte Grid-Zeilen verpackt in der BabCom-Konsole
   ========================================================================== */

/* Umschließender Container: Reicht Daten blockadenfrei an das Hauptfenster weiter */
#contact-section {
    display: block;
    width: 100%;
    max-height: none;
    overflow: visible; 
    margin: 10px auto 20px auto; 
}

/* Die äußere Gehäuse-Box des Formulars */
.contact-fieldset {
    font-family: 'B5Station', Arial, sans-serif;
    color: hsl(0, 9%, 98%);
    letter-spacing: 1px;
    /* Subtiles Leuchten stützt das weiße Label-Schriftbild */
    text-shadow: 0 0 4px rgba(96, 172, 243, 0.5), 1px 1px 2px rgba(0, 0, 0, 0.7); 
    padding: 10px;               
    max-width: 600px;            
    max-height: none;     
    overflow: visible;    
    text-align: center;
    
    /* Symmetrie-Garantie: Oben 10px Luft, links/rechts perfekt ausgemittelt */
    margin: 10px auto 20px auto; 
    
    /* Veredelter Glaslook passend zum Haupt-Interface */
    background-color: rgba(13, 20, 59, 0.6); 
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border: 1px solid rgba(96, 172, 243, 0.3); 
    border-radius: 10px; 
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 12px rgba(26, 47, 122, 0.3);
}

/* Taktische Box-Überschrift */
.contact-fieldset legend {
    font-weight: bold;
    text-decoration: underline;
    letter-spacing: 1px;
    padding: 0 10px;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.4);
}

/* Flex-Reihen: Halten die Eingabefelder auf breiten Bildschirmen stabil nebeneinander */
.contact-fieldset .form-row {
    display: flex;
    flex-wrap: wrap; 
    gap: 10px;                   
    margin-bottom: 5px;          
    padding: 0 5px;              
}

/* --- SPALTEN- & FELD-STEUERUNG --- */

/* Standard-Gruppe: Teilt die Zeile flexibel auf (perfekt für Name und E-Mail) */
.contact-fieldset .form-group {
    flex: 1;
    min-width: 250px;            /* Verhindert das Quetschen der Felder auf kleineren Tablets */
    text-align: left;
}

/* Vollbild-Spalte: Erzwingt die volle Breite (für Betreff und Nachrichtenfeld) */
.contact-fieldset .full-width {
    flex: 0 0 100%;
}

/* --- TEXTE & EINGABEN --- */

/* Feld-Beschriftungen über den Eingabeboxen */
.contact-fieldset label {
    display: block;
    margin-bottom: 5px;
    font-size: 0.95em;
    letter-spacing: 1px;         
}

/* Die transparenten Glas-Eingabefelder (Inputs & Textareas) */
.contact-fieldset input, 
.contact-fieldset textarea {
    width: 100%;                 
    padding: 8px 10px;           
    box-sizing: border-box;      
    
    /* Integrierter, semi-transparenter Terminal-Look */
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(96, 172, 243, 0.3);
    border-radius: 5px;          
    color: hsl(0, 9%, 98%);
}

/* Daten-Fokus: Das aktive Eingabefeld leuchtet bei Klick sofort in Gold-Orange auf */
.contact-fieldset input:focus, 
.contact-fieldset textarea:focus {
    outline: none;
    border-color: #ff9900;
    box-shadow: 0 0 8px rgba(255, 153, 0, 0.5);
}

/* Das große Übertragungsfeld für den eigentlichen Nachrichtentext */
.contact-fieldset textarea {
    font-family: Arial, sans-serif; 
    resize: vertical;            /* Erlaubt dem User nur vertikales Ziehen, um das Grid zu schützen */
}

/* --- TRANSMIT-BUTTON (Datenübertragung) --- */
.contact-fieldset button.formButton {
    display: block;
    margin: auto auto auto auto; /* Hält den Button perfekt im Zentrum der Box verankert */
    padding: 8px 25px;           
    cursor: pointer; 
    
    /* Veredelter Konsolen-Look passend zum restlichen Glas-Interface */
    background-color: rgba(26, 47, 122, 0.4);
    border: 1px solid rgba(96, 172, 243, 0.4);
    border-radius: 5px;
    color: hsl(0, 9%, 98%);
    transition: all 0.3s ease;    
    
    /* Blaues Plasma-Leuchten für den weißen Button-Text */
    text-shadow: 0 0 4px rgba(96, 172, 243, 0.6);
    letter-spacing: 1px;         
}

/* Button-Hover: Zündet bei Mausberührung den goldenen Plasma-Glow */
.contact-fieldset button.formButton:hover {
    color: #ff9900;
    border-color: #ff9900;
    box-shadow: 0 0 8px rgba(255, 153, 0, 0.6);
}

/* --- AUTOMATISIERTE SICHERHEITSSYSTEME --- */

/* Honeypot: Bleibt absolut unsichtbar, um Spam-Bots eiskalt ins Leere laufen zu lassen */
#zusatzinfo_kontakt {
    display: none !important;
}

/* Kleine Formular-Hinweise am unteren Rand */
.form-hint {
    font-size: 0.8em;
    color: hsl(0, 1%, 70%);
}

/* ==========================================
   CHARAKTER-KARTEN DESIGN (Matrix-Layout)
   ========================================== */
.char-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 15px;
}

.char-card {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 15px;
    background-color: rgba(5, 8, 26, 0.35);
    border: 1px solid rgba(96, 172, 243, 0.2);
    border-radius: 8px;
    text-align: left;
    box-shadow: inset 0 0 10px rgba(26, 47, 122, 0.15);
}

.char-image-placeholder {
    width: 120px;
    height: 120px;
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px dashed rgba(96, 172, 243, 0.4);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7em;
    color: rgba(96, 172, 243, 0.7);
    padding: 10px;
    text-align: center;
    flex-shrink: 0;
}

.char-info {
    flex: 1;
    min-width: 200px;
}

.char-info h4 {
    color: #ff9900;
    font-family: 'SerpentineB5';
    text-shadow: 0 0 5px rgba(255, 153, 0, 0.4);
    margin-bottom: 5px;
}

.char-meta {
    font-size: 0.9em;
    color: hsl(0, 9%, 98%) !important;
    margin-bottom: 8px;
}

/* ==========================================
   TIMELINE-STREAMS (Taktischer Datenstrom)
   ========================================== */
.timeline-stream {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
    border-left: 2px solid rgba(96, 172, 243, 0.2); /* Die durchgehende Datenlinie links */
    padding-left: 20px;
    text-align: left;
}

.timeline-node {
    position: relative;
}

.timeline-badge {
    font-family: 'B5Station';
    color: #ff9900;
    font-size: 0.9em;
    font-weight: bold;
    margin-bottom: 5px;
    text-shadow: 0 0 5px rgba(255, 153, 0, 0.5);
}

.font-active {
    color: #ff9900 !important;
    text-shadow: 0 0 8px rgba(255, 153, 0, 0.8) !important;
}

.timeline-content {
    background-color: rgba(5, 8, 26, 0.25);
    border: 1px solid rgba(96, 172, 243, 0.15);
    border-radius: 6px;
    padding: 12px 15px;
    box-shadow: inset 0 0 10px rgba(26, 47, 122, 0.1);
}

/* Hebt das aktuelle Spieljahr 2264 optisch hervor */
.box-active {
    background-color: rgba(26, 47, 122, 0.2) !important;
    border-color: rgba(96, 172, 243, 0.4) !important;
    box-shadow: 0 0 10px rgba(96, 172, 243, 0.2), inset 0 0 10px rgba(26, 47, 122, 0.2) !important;
}

.timeline-content h4 {
    color: hsl(0, 9%, 98%);
    font-family: 'B5Station';
    margin-bottom: 6px;
    letter-spacing: 0.5px;
}

.timeline-content p {
    color: rgb(96, 172, 243) !important;
    padding: 0 !important;
    text-align: left !important;
    font-size: 0.95em;
    line-height: 1.5;
}
